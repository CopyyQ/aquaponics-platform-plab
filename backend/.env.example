APP_NAME="Aquaponics Monitoring API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_SESSION_DAYS=30
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aquaponics
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Generate a Fernet key and set it here. Backend startup intentionally fails while this is blank/invalid.
FERNET_KEY=
LOGIN_RATE_LIMIT_IDENTITY_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_RETENTION_HOURS=24
AUTH_SESSION_RETENTION_DAYS=90
MQTT_HOST=mqtt
MQTT_PUBLIC_HOST=192.168.1.182
MQTT_PORT=1883
MQTT_PUBLIC_PORT=1883
MQTT_AUTHENTICATION=false
MQTT_TLS=false
MQTT_CLIENT_ID=aquaponics-backend
MQTT_TELEMETRY_TOPIC=aquaponics/+/telemetry
MQTT_STATUS_TOPIC=aquaponics/+/status
MQTT_COMMAND_TOPIC=aquaponics/{device_code}/commands
MQTT_ACK_TOPIC=aquaponics/+/command-ack
MQTT_QOS=1
ACTUATOR_COMMAND_TIMEOUT_SECONDS=45
ACTUATOR_COMMAND_DISPATCH_INTERVAL_SECONDS=1
ACTUATOR_COMMAND_PUBLISH_MAX_ATTEMPTS=7
ACTUATOR_COMMAND_PUBLISH_BATCH_SIZE=20
ACTUATOR_COMMAND_PUBLISH_TIMEOUT_SECONDS=5
DEVICE_OFFLINE_SECONDS=300
SENSOR_OFFLINE_SECONDS=300
JOB_INTERVAL_SECONDS=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-your-own-admin-password
RESET_DEFAULT_ADMIN_PASSWORD=true
TELEGRAM_BOT_TOKEN=
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
TELEGRAM_DEVICE_SENSOR_LIMIT=6
TELEGRAM_NOTIFY_ACTUATOR_ACK=false
PROJECT_HEALTH_INTERVAL_SECONDS=300

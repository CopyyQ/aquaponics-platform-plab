APP_NAME="Aquaponics Monitoring API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aquaponics
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FERNET_KEY=
MQTT_HOST=mqtt
MQTT_PUBLIC_HOST=192.168.1.182
MQTT_PORT=1883
MQTT_PUBLIC_PORT=1883
MQTT_AUTHENTICATION=false
MQTT_TLS=false
MQTT_CLIENT_ID=aquaponics-backend
MQTT_TELEMETRY_TOPIC=aquaponics/+/telemetry
MQTT_STATUS_TOPIC=aquaponics/+/status
DEVICE_OFFLINE_SECONDS=300
SENSOR_OFFLINE_SECONDS=300
JOB_INTERVAL_SECONDS=60
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-your-own-admin-password
RESET_DEFAULT_ADMIN_PASSWORD=true
TELEGRAM_BOT_TOKEN=
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
PUBLIC_MONITORING_PROJECT_ID=
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
TELEGRAM_DEVICE_SENSOR_LIMIT=6
TELEGRAM_NOTIFY_ACTUATOR_ACK=false
PROJECT_HEALTH_INTERVAL_SECONDS=300
